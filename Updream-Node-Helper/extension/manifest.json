{
  "manifest_version": 3,
  "name": "Updream MCP Bridge",
  "version": "0.3.1",
  "minimum_chrome_version": "120",
  "description": "通过本机 MCP 和浏览器桥接，让 Codex 直接调用 updream 节点接口，减少网页点击。",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://www.updream.cn/*", "https://updream.cn/*", "https://updream.bilibili.com/*", "http://127.0.0.1/*"],
  "background": {"service_worker":"background.js"},
  "action": {
    "default_title": "Updream MCP 连接状态",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.updream.cn/*", "https://updream.cn/*", "https://updream.bilibili.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.updream.cn/*", "https://updream.cn/*", "https://updream.bilibili.com/*"],
      "js": ["client.js", "content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
